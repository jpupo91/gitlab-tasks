<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gitlab-tasks" path="/org/gnome/shell/extensions/gitlab-tasks/">
    <key name="gitlab-url" type="s">
      <default>''</default>
      <summary>URL de la instancia GitLab</summary>
    </key>
    <key name="private-token" type="s">
      <default>''</default>
      <summary>Token de acceso personal de GitLab</summary>
    </key>
    <key name="poll-interval" type="i">
      <default>300</default>
      <range min="60" max="3600"/>
      <summary>Intervalo de actualización en segundos</summary>
    </key>
  </schema>
</schemalist>
